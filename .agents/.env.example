# Jarvis 3D Printing Assistant — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file — it's in .gitignore

# Moonraker API URL (Cloudflare Tunnel or local network)
# Example: https://your-tunnel.trycloudflare.com
export MOONRAKER_URL=

# Moonraker API Key (optional — only if auth is enabled in Moonraker)
export MOONRAKER_API_KEY=

# Base44 Service Token (auto-generated, do not share)
export BASE44_SERVICE_TOKEN=
